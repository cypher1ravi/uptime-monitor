# Copy to .env for local development
# log = print results, pubsub = publish to Google Pub/Sub
SINK=log
PUBSUB_TOPIC=uptime-checks
# file = .state.json (dev), firestore = production
STATE_STORE=file
CHECK_TIMEOUT_MS=10000
RETRY_DELAY_MS=3000
# Optional locally: real Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
