{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uptime-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uptime",
      // Replace with the id printed by `npx wrangler d1 create uptime` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Check all sites every minute.
  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    "STATUS_PAGE_TITLE": "Ravindra's services",
    "CHECK_TIMEOUT_MS": "10000",
    "RETRY_DELAY_MS": "3000",
    "RETENTION_DAYS": "90"
  },
  // Secrets (npx wrangler secret put NAME): TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID

  "observability": { "enabled": true }
}
