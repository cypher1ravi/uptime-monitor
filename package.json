{
  "name": "uptime-monitor",
  "version": "0.2.0",
  "private": true,
  "description": "Uptime monitor with a public status page and Telegram alerts on Cloudflare Workers + D1 (free tier)",
  "type": "module",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply uptime --local",
    "db:migrate:remote": "wrangler d1 migrations apply uptime --remote",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "typescript": "^5",
    "wrangler": "4.158.0"
  }
}
